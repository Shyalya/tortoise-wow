##################################################################################
#                                                                                #
# Premade builds                                                                 #
#                                                                                #
##################################################################################
#
# AiPlayerbot.PremadeSpecName.<class>.<specno> = <name>         #Name of the talent specialisation
# AiPlayerbot.PremadeSpecProb.<class>.<specno> = <number>       #Probability Randombots will pick this spec. (default 100)
# AiPlayerbot.PremadeSpecLink.<class>.<specno>.<level> = <link> #Wowhead style link the bot should work towards at given level.

#
# Rogue example
# Assassination example

# Hand-built level 60 specs, one per role where the class has one, with a
# levelling path every five levels so low level bots start in the main tree.
# The stock links are vanilla ones and every single one of them is rejected
# against Turtle's reworked talent trees.

# --- Klasse 1 ---
# Hand-built level 60 talent specs, one per role where a class has one,
# each with a levelling path every five levels so low level bots start in
# the main tree rather than the secondary one.
#
# The stock links are vanilla ones and every single one of them is rejected
# against Turtle's reworked talent trees.
#
# Generated for Rate.Talent = 1, which is what mangosd.conf.dist ships, so
# level 60 carries 51 of the 61 points each build was designed with. Running
# a different rate? Regenerate, or the server rejects every entry with
# "spec is for a higher level":
#
#   tools/talents/build_premade_specs.py --dbc <dbc dir> --rate <your rate>

# --- class 1 ---
AiPlayerbot.PremadeSpecName.1.0 = fury
AiPlayerbot.PremadeSpecProb.1.0 = 100
AiPlayerbot.PremadeSpecLink.1.0.10 = -01
AiPlayerbot.PremadeSpecLink.1.0.15 = -051
AiPlayerbot.PremadeSpecLink.1.0.20 = -0551
AiPlayerbot.PremadeSpecLink.1.0.25 = -05551
AiPlayerbot.PremadeSpecLink.1.0.30 = -05555000001
AiPlayerbot.PremadeSpecLink.1.0.35 = -0555500000312
AiPlayerbot.PremadeSpecLink.1.0.40 = -055550000031223
