###################################################################################################
# mod-turtlebots module configuration
###################################################################################################

[ModuleConf]

# Enable the bot module.
mod-turtlebots.Enable = 1

# Target number of bots the module keeps online.
# (Phase 1 spawns this many at startup; later this becomes a live target,
#  adjustable from the web panel.)
mod-turtlebots.Count = 3

# The first N of those bots are city residents (the rest are legacy adventurers).
mod-turtlebots.Residents = 3

###################################################################################################
# Town mode (Kith model): residents are "shadows" (logged out) until a real player is in
# their home city. Then they are woken (logged in) in staggered batches and put back to
# sleep (logged out) after a grace period with no player in the city.
# Off = residents are simply kept online all the time.
###################################################################################################
mod-turtlebots.Town.Enable = 0

# How many residents may log in/out per WakeIntervalMs (avoids login storms).
mod-turtlebots.Town.WakeBatch = 5
mod-turtlebots.Town.WakeIntervalMs = 10000

# Seconds without a real player before a city goes back to sleep.
mod-turtlebots.Town.SleepGraceSec = 600

# Comma-separated zone ids to keep awake even with nobody there (observation/streaming),
# e.g. 1637 for Orgrimmar. Re-read on config reload.
mod-turtlebots.Town.ForceAwake =

# Off-shift adventurers as residents: characters on accounts with this prefix (the
# TortoiseBots random-bot accounts) that are currently logged out come home to the
# city as residents while it is awake, and are released for their next shift when it
# falls asleep. Fill caps the residents embodied per awake city (TBOT + pool);
# 0 = just the Residents count above. Horde characters only until the multi-city split.
mod-turtlebots.Town.Fill = 0
mod-turtlebots.Town.PoolAccountPrefix = RNDBOT
# Seconds between DB refreshes of the pool, and how long a released character is left
# alone (so its next shift can pick it up) before it may come home again.
mod-turtlebots.Town.PoolRefreshSec = 300
mod-turtlebots.Town.ReleaseCooldownSec = 600
