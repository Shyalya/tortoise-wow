###################################################################################################
# mod-turtlebots module configuration
###################################################################################################

[ModuleConf]

# Enable the bot module.
mod-turtlebots.Enable = 1

# Target number of bots the module keeps online.
# (Phase 1 spawns this many at startup; later this becomes a live target,
#  adjustable from the web panel.)
mod-turtlebots.Count = 3

# The first N of those bots are city residents (the rest are legacy adventurers).
mod-turtlebots.Residents = 3

###################################################################################################
# Town mode (Kith model): residents are "shadows" (logged out) until a real player is in
# their home city. Then they are woken (logged in) in staggered batches and put back to
# sleep (logged out) after a grace period with no player in the city.
# Off = residents are simply kept online all the time.
###################################################################################################
mod-turtlebots.Town.Enable = 0

# How many residents may log in/out per WakeIntervalMs (avoids login storms).
mod-turtlebots.Town.WakeBatch = 5
mod-turtlebots.Town.WakeIntervalMs = 10000

# Seconds without a real player before a city goes back to sleep.
mod-turtlebots.Town.SleepGraceSec = 600

# Comma-separated zone ids to keep awake even with nobody there (observation/streaming),
# e.g. 1637 for Orgrimmar. Re-read on config reload.
mod-turtlebots.Town.ForceAwake =

# Off-shift adventurers as residents: characters on accounts with this prefix (the
# TortoiseBots random-bot accounts) that are currently logged out come home to the
# city as residents while it is awake, and are released for their next shift when it
# falls asleep. Fill caps the residents embodied per awake city (TBOT + pool);
# 0 = just the Residents count above. Horde characters only until the multi-city split.
mod-turtlebots.Town.Fill = 0
mod-turtlebots.Town.PoolAccountPrefix = RNDBOT
# Seconds between DB refreshes of the pool, and how long a released character is left
# alone (so its next shift can pick it up) before it may come home again.
mod-turtlebots.Town.PoolRefreshSec = 300
mod-turtlebots.Town.ReleaseCooldownSec = 600

###################################################################################################
# RESIDENTS' VOICE (LLM)
#
#    mod-turtlebots.LLM.Enabled
#        Residents speak through an OpenAI-style chat endpoint (Ollama). Off = canned lines only.
#        Default: 1
#
#    mod-turtlebots.LLM.Url / mod-turtlebots.LLM.Model / mod-turtlebots.LLM.TimeoutMs
#        Endpoint (plain http), model name, and how long a line may take before the canned
#        fallback is spoken instead. Default: http://100.69.207.60:11434/v1/chat/completions,
#        qwen2.5:32b-instruct-q4_K_M, 5000
#
#    mod-turtlebots.LLM.Ambient
#        Ambient small talk out loud, generated from what the resident is doing and who is around.
#        Default: 1
#
#    mod-turtlebots.LLM.AmbientPerMinute
#        City-wide cap on ambient lines per minute across all residents (LLM or canned).
#        Default: 6
#
#    mod-turtlebots.LLM.DialogueChance
#        Chance (%) that a neighbour within earshot answers a spoken line (bot-to-bot dialogue,
#        at most two answers per opening line). Default: 60
#
#    mod-turtlebots.LLM.Log
#        Log every delivered line with its latency ([mod-turtlebots] llm ...). Default: 1
#
# All of these are live: change the file and issue "reload config" on the console.
###################################################################################################

mod-turtlebots.LLM.Enabled = 1
mod-turtlebots.LLM.Url = http://100.69.207.60:11434/v1/chat/completions
mod-turtlebots.LLM.Model = qwen2.5:32b-instruct-q4_K_M
mod-turtlebots.LLM.TimeoutMs = 5000
mod-turtlebots.LLM.Ambient = 1
mod-turtlebots.LLM.AmbientPerMinute = 6
mod-turtlebots.LLM.DialogueChance = 60
mod-turtlebots.LLM.Log = 1

###################################################################################################
# TRADE WATCH
#
#    While the city sleeps (town mode), an item offer in the Trade channel wakes one resident
#    that fits the item; it quotes by whisper, stays up ten minutes (longer while the deal is
#    pending) and goes back to sleep. Nothing to configure.
#
#    mod-turtlebots.Debug.TradeWake
#        Pretend such an offer arrived (tests the wake/keep-up/release path without a client).
#        Leave at 0 in normal operation. Default: 0
###################################################################################################

mod-turtlebots.Debug.TradeWake = 0

###################################################################################################
# WORLD KNOWLEDGE
#
#    Location questions ("where is the bank / the mage trainer / Gryshka / a mailbox ...") in /say,
#    whispers and channels are answered from the live world around the asker (600 yards), as a
#    fact the model only phrases. Lore questions ("what drops X", "who sells X", "who gives the
#    quest X" - the item may be linked) are answered from the world database the same way.
#    Nothing to configure.
#
#    mod-turtlebots.Debug.FactSelfTest
#        Each resident asks the standard questions once from where it stands and logs the facts.
#        Leave at 0 in normal operation. Default: 0
###################################################################################################

mod-turtlebots.Debug.FactSelfTest = 0

###################################################################################################
# CHANNELS
#
#    Residents join "Trade - City" and "World" while they live in the city. An item offer in
#    Trade is quoted by whisper; a location question, or a resident called by name, is answered
#    in the same channel (Trade, World, General). While the city sleeps, one resident is woken
#    for it (see TRADE WATCH).
#
#    mod-turtlebots.LLM.MarketCallMinutes
#        Every N minutes (city-wide) one resident calls out in Trade what its craft is buying,
#        with a real item link and a market price (a player answering with a link sells to
#        it). Only while a real player is online, or the city is forced awake. 0 = no calls.
#        Default: 3
###################################################################################################

mod-turtlebots.LLM.MarketCallMinutes = 3

###################################################################################################
# CHANNEL SMALL TALK
#
#    Ordinary lines in World, General and Trade (a greeting, a question, a remark, a jab) get an
#    answer sometimes, the way a populated channel behaves: a greeting or "anyone here?" always,
#    a question 70 %, a remark 40 %, a jab 75 %, capped city-wide per minute. Place and lore
#    questions (places by name via the teleport table, crafts without the word "trainer", the
#    nearest one anywhere on the map) and a resident called by name are always answered.
#    A resident that is up answers (the asker's zone first); while the city sleeps a resident
#    answers from its sleep - the line goes out in its name without waking it. Now and then a
#    second resident adds its own angle (a question 35 %, a jab 60 %).
#
#    mod-turtlebots.LLM.ChannelTalk
#        Answer ordinary channel chatter at all. Default: 1
#
#    mod-turtlebots.LLM.ChannelPerMinute
#        City-wide cap on such answers per minute (place, lore and by-name answers do not
#        count). Default: 6
#
#    mod-turtlebots.LLM.ShadowVoices
#        Sleeping residents may answer in channels, in their own name, without logging in.
#        Default: 1
#
#    mod-turtlebots.Debug.ChannelSelfTest
#        On the config reload that switches it on, four channel lines (a greeting, two place
#        questions, an opinion question) are fed through the handler in the name of the first
#        real player in the world, 23 s apart, and logged. Set it back to 0 afterwards. Default: 0
###################################################################################################

mod-turtlebots.LLM.ChannelTalk = 1
mod-turtlebots.LLM.ChannelPerMinute = 6
mod-turtlebots.LLM.ShadowVoices = 1
mod-turtlebots.Debug.ChannelSelfTest = 0

###################################################################################################
# CHANNEL LIFE
#
#    The channels live on their own, not only when a player speaks: a resident opens a line in
#    World now and then (an opinion, a rumour, a question), another answers (60 %), the first
#    replies once more (40 %). A Trade call draws a second resident's interest or haggling, and
#    the caller answers back (40 %). Sleeping residents take part in all of it, so the channels
#    are populated whether a city is awake or not. A player who was answered in a channel is
#    answered again by the same resident when they reply within 90 s (always, no pause) - a
#    conversation, corrections included. Only while a real player is online.
#
#    mod-turtlebots.LLM.WorldTalkMinutes
#        Every N minutes (plus up to a minute of jitter) a resident opens a line in World.
#        0 = off. Default: 4
#
#    mod-turtlebots.LLM.MarketReplyChance
#        Chance (%) that another resident answers a Trade call in the channel. Default: 60
###################################################################################################

mod-turtlebots.LLM.WorldTalkMinutes = 4
mod-turtlebots.LLM.MarketReplyChance = 60

###################################################################################################
# PLAYER MEMORY (#51) AND OWN EVENTS (#155)
#
#    A resident remembers each real player it dealt with (table mod_turtlebots_player_memory:
#    first and last contact, how many encounters, the last six things - asked the way,
#    whispered, sold loot, cast a buff, waved, grouped) and lets it show in its answers. A
#    player it knows who turns up nearby after a while away is greeted by name (once per player
#    per fifteen minutes city-wide). What happens to our bots - a death and its cause, a level,
#    a notable kill, a PvP kill or death - is kept per character (mod_turtlebots_char_events)
#    and a resident may bring it up, also from its time out in the world as an adventurer.
#
#    mod-turtlebots.Memory.Enabled
#        Default: 1
#
#    mod-turtlebots.Memory.ReturnMinutes
#        A player counts as back again after this many minutes without contact. Default: 120
###################################################################################################

mod-turtlebots.Memory.Enabled = 1
mod-turtlebots.Memory.ReturnMinutes = 120

###################################################################################################
# TRAVEL BETWEEN CITIES (#23)
#
#    Residents travel between the capitals of their faction: by flight on the same continent
#    (Orgrimmar - Thunder Bluff, Stormwind - Ironforge; the real taxi ride, node by node), by
#    their own portal if they are a mage of the level. Another continent without a portal is
#    not reachable yet (no zeppelin). A visitor lives in the other city for 8-15 minutes (its
#    errands, channels and fishing spots are those of that city) and flies home. A service
#    asked for in a channel (water, food, healthstone, portal, a buff) fetches a resident of
#    the right class: one in the player's city walks over; else one from another city travels
#    there; else one is woken in its home city and sent on its way. The player has to stand in
#    a capital - residents do not leave the cities.
#
#    mod-turtlebots.Travel.Enabled
#        Default: 1
#
#    mod-turtlebots.Travel.TripMinutes
#        One ambient departure per N minutes city-wide (only while a real player is online).
#        0 = no ambient trips. Default: 20
#
#    mod-turtlebots.Travel.Dispatch
#        Channel requests fetch a resident as described. Default: 1
###################################################################################################

mod-turtlebots.Travel.Enabled = 1
mod-turtlebots.Travel.TripMinutes = 20
mod-turtlebots.Travel.Dispatch = 1

###################################################################################################
# GROUP, GUILD, EMOTES
#
#    A resident accepts a real player's group invitation (and stays half an hour, or until no
#    player is left in the group), answers in party when called by name or asked, now and then
#    otherwise. A guild invitation is accepted the same way; guild chat is answered alike.
#    Emotes aimed at a resident get a gesture back and a word in character. Nothing to configure.
#
#    mod-turtlebots.Debug.SocialSelfTest
#        Two residents act out an emote and a party exchange once (checks the plumbing without a
#        client). Leave at 0 in normal operation. Default: 0
###################################################################################################

mod-turtlebots.Debug.SocialSelfTest = 0

###################################################################################################
# DIAGNOSTICS
#
#    mod-turtlebots.Debug.StuckProbe
#        Apply the stuck rule of the telemetry (position unchanged for 8 s while the bot is in a
#        moving state, sampled once a second) to every awake resident and log each hit together
#        with what the resident was doing (errand, fishing, cooking, following). Traces a stuck
#        report to the behaviour behind it. Leave at 0 in normal operation. Default: 0
###################################################################################################

mod-turtlebots.Debug.StuckProbe = 0

###################################################################################################
# HOME CITIES (#151)
#
#    mod-turtlebots.Town.Cities
#        The capitals residents live in, comma-separated keys: orgrimmar, thunderbluff, undercity,
#        stormwind, ironforge, darnassus. Resident accounts are spread over the enabled cities of
#        their faction (existing characters keep their race; new ones alternate Horde/Alliance);
#        off-shift adventurers come home to the city of their race. Town.Fill applies per city.
#        Points of interest are discovered from the DB around each hub. Live (reload config).
#        Default: orgrimmar,thunderbluff,undercity,stormwind,ironforge,darnassus
###################################################################################################

mod-turtlebots.Town.Cities = orgrimmar,thunderbluff,undercity,stormwind,ironforge,darnassus
